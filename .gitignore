# Python
__pycache__/
*.py[cod]
.venv/

# Node / Next.js
web/node_modules/
web/.next/
web/out/
web/.env*.local

# Blender recovery and autosave files
*.blend1
*.blend2
*.blend@

# Generated test artifacts are reproducible and intentionally not versioned.
blender/scenes/*.blend
blender/scenes/bgc/tiles/*.blend
blender/renders/**/*.png
blender/renders/**/*.html
exports/glb/*.glb
blender/buildings/**/scenes/*.blend
blender/buildings/**/renders/**/*.png
exports/glb/buildings/*.glb
web/public/models/*.glb
web/public/models/**/*.glb
exports/bgc/tiles/*.glb

# Keep otherwise-empty project directories.
!.gitkeep
