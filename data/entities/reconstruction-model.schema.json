{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bgc/reconstruction-model.schema.json",
  "title": "BGC reconstruction record",
  "type": "object",
  "required": ["schema_version", "sources", "entities", "observations", "assets", "jobs"],
  "properties": {
    "schema_version": { "const": 1 },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "jobs": { "type": "array", "items": { "$ref": "#/$defs/job" } }
  },
  "$defs": {
    "evidenceClass": {
      "enum": ["VERIFIED_GEOGRAPHIC", "VERIFIED_PHOTOGRAPHIC", "INFERRED", "ESTIMATED", "PROCEDURAL", "UNKNOWN"]
    },
    "source": {
      "type": "object",
      "required": ["id", "title", "access_url", "license", "retrieved_at"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "access_url": { "type": "string" },
        "license": { "type": "string" },
        "attribution": { "type": "string" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "original_crs": { "type": ["string", "null"] },
        "content_hash": { "type": ["string", "null"] }
      }
    },
    "entity": {
      "type": "object",
      "required": ["id", "entity_type", "geometry", "reconstruction_status"],
      "properties": {
        "id": { "type": "string" },
        "entity_type": { "enum": ["Building", "Road", "Path", "OpenSpace", "POI", "ReferenceImage"] },
        "name": { "type": ["string", "null"] },
        "geometry": { "type": ["object", "null"] },
        "importance_tier": { "enum": ["A", "B", "C", null] },
        "reconstruction_status": { "enum": ["UNASSESSED", "BASE_READY", "REFERENCE_READY", "REFINING", "QA", "APPROVED"] },
        "reference_coverage": { "$ref": "#/$defs/coverage" },
        "source_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "observation": {
      "type": "object",
      "required": ["id", "entity_id", "field", "evidence_class", "confidence", "source_ids"],
      "properties": {
        "id": { "type": "string" },
        "entity_id": { "type": "string" },
        "field": { "type": "string" },
        "value": {},
        "evidence_class": { "$ref": "#/$defs/evidenceClass" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source_ids": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "observed_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "north_facade": { "$ref": "#/$defs/coverageAspect" },
        "south_facade": { "$ref": "#/$defs/coverageAspect" },
        "east_facade": { "$ref": "#/$defs/coverageAspect" },
        "west_facade": { "$ref": "#/$defs/coverageAspect" },
        "entrance": { "$ref": "#/$defs/coverageAspect" },
        "roof": { "$ref": "#/$defs/coverageAspect" },
        "street_context": { "$ref": "#/$defs/coverageAspect" },
        "aerial_context": { "$ref": "#/$defs/coverageAspect" }
      },
      "additionalProperties": false
    },
    "coverageAspect": {
      "type": "object",
      "required": ["rating", "reference_image_ids"],
      "properties": {
        "rating": { "enum": ["NONE", "WEAK", "ADEQUATE", "GOOD"] },
        "reference_image_ids": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "asset": {
      "type": "object",
      "required": ["id", "entity_ids", "lod", "path", "generator_version"],
      "properties": {
        "id": { "type": "string" },
        "entity_ids": { "type": "array", "items": { "type": "string" } },
        "lod": { "enum": [0, 1, 2, 3] },
        "path": { "type": "string" },
        "generator_version": { "type": "string" },
        "metrics": { "type": "object" }
      }
    },
    "job": {
      "type": "object",
      "required": ["id", "job_type", "input_ids", "status"],
      "properties": {
        "id": { "type": "string" },
        "job_type": { "enum": ["INGEST", "NORMALIZE", "GENERATE", "EXPORT", "QA"] },
        "input_ids": { "type": "array", "items": { "type": "string" } },
        "output_ids": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["PENDING", "RUNNING", "SUCCEEDED", "FAILED"] },
        "tool_version": { "type": "string" }
      }
    }
  }
}
